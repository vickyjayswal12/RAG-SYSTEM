# Rename this file to .env and fill in your own values

# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# These match the docker-compose.yml postgres service.
# Leave as-is if you're using docker-compose exactly as provided.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# Chunking config
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Gemini models
EMBEDDING_MODEL=models/text-embedding-004
GENERATION_MODEL=models/gemini-1.5-flash
